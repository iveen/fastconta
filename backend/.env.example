# Base de datos
DATABASE_HOST=192.168.64.4
DATABASE_PORT=5432
DATABASE_USER="fastconta_user"
DATABASE_PASSWORD="your_database_user_password"
DATABASE_NAME="fastconta_database"

# JWT
SECRET_KEY="Your Secret Key"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT="development"

# EMAIL CONFIGURATION
SMTP_HOST=mailtrap-host.com
SMTP_PORT=587
SMTP_USER=mailtrapuser
SMTP_PASSWORD="mailtrap_password"
SMTP_TLS=True
SMTP_SSL=False
SMTP_TOKEN="mailtrap_token"
APP_URL="https://yourapp.url"
FROM_EMAIL="noreply@yourapp.url"
FROM_NAME="FastConta"

# ============================================================
# 🆕 Redis + Celery (ADR 001)
# ============================================================

# URL de Redis (broker de mensajes)
# Formato: redis://[:password]@hostname:port/db_number
REDIS_URL=redis://localhost:6379/0

# URL del broker de Celery (usualmente igual a REDIS_URL)
CELERY_BROKER_URL=redis://localhost:6379/0

# Backend de resultados de Celery (usamos BD propia, pero Celery lo requiere)
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# 🆕 Flower (monitoreo de Celery) — solo producción
# ============================================================
FLOWER_USER=admin
FLOWER_PASSWORD=changeme_in_production

